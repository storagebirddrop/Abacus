# Abacus configuration
# Copy to .env and adjust as needed

# HTTP port
PORT=8080

# SQLite database path
DB_PATH=./abacus.db

# Environment: development | production
ENV=production

# NOTE: there is no VERSION env var. The version reported by /api/v1/version
# is baked into the binary at build time via `-ldflags "-X main.version=<tag>"`
# (see Makefile); untagged/dev builds report "dev".

# Directory containing the compiled frontend (web/dist)
FRONTEND_DIR=./web/dist

# --- API security ---
# Optional bearer token. When set, every /api/v1 request (except health/version)
# must send `Authorization: Bearer <token>`. Off by default — intended for
# deployments exposed beyond localhost (e.g. behind a reverse proxy). The
# bundled web UI attaches this token automatically once you save it on the
# Settings → API access page. Leave empty for the default offline/localhost
# setup. Generate a strong value — do not use a short or guessable string:
#   openssl rand -hex 32
# API_TOKEN=

# Per-IP request cap for /api/v1, requests per minute. Set to 0 to disable.
RATE_LIMIT_RPM=600

# Trust X-Forwarded-For / X-Real-IP for the client IP (used by rate limiting).
# Enable ONLY when Abacus runs behind a trusted reverse proxy that sets these
# headers — otherwise clients can spoof them to evade per-IP rate limiting.
# TRUST_PROXY=false

# Blockchain sync (Esplora / Electrum backend, URLs, TLS, rate limit) is NOT
# configured here. It is disabled by default and configured at runtime in the
# in-app Settings page, persisted in SQLite — no restart needed. See the
# Settings tab in the UI.
#
# Privacy: enabling sync queries the configured server for your wallet's
# addresses, disclosing them to that third party. For maximum privacy, point it
# at an Esplora/Electrum instance you host yourself. Abacus never stores or
# transmits keys or signing material.
